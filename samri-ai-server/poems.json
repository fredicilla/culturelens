 "homeland": {
  "topic": {
   "en": "The homeland",
   "ar": "الوطن"
  },
  "mean": {
   "en": "Our land, our pride, there is none like you; from her east to her west, all of it is beauty. Your sea, your desert, the mountain and your palms; may she stay dear forever, and God protect her.",
   "ar": "عن الوطن وعزه وجماله من شرقه لغربه، بحره وبره وجباله ونخيله."
  },
